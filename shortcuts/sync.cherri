// “同步相册到小桔云盘”快捷指令（Cherri 语言，https://github.com/electrikmilk/cherri）。
// 由 shortcuts/build.py 编译、签名，发布网页时一起放到 GitHub Pages（xiaoju-sync.shortcut）。
//
// 不用选照片：按拍摄时间从旧到新，一批 50 张地把整个相册传进网盘根目录的“相册”文件夹。一次查整个相册
// 会超出快捷指令的内存上限，所以每批只查“进度之后”最旧的 50 张，一次运行最多 10 批（500 张）。
// 进度（已经传到哪张照片的拍摄时间）存在 iCloud 云盘「快捷指令」文件夹的 xiaoju-sync.json 里，每传一张存一次：
// 中途停了、出错了，下次运行从那张接着传。服务端仍然只进不出、不需要密钥，同名同大小的文件会跳过。
#include 'actions/photos'
#include 'actions/images'
#include 'actions/scripting'
#include 'actions/media'
#include 'actions/documents'
#include 'actions/calendar'
#define name 同步相册到小桔云盘
#define color orange
#define glyph photoStack

// 「获取 URL 的内容」：POST，请求体是文件本身
action 'downloadurl' uploadFile(
    text url: 'WFURL',
    variable file: 'WFRequestVariable',
    dictionary! headers: 'WFHTTPHeaders'
) {
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File",
    "ShowHeaders": true
}

// 上传地址：构建时由 build.py 换成网盘地址
@uploadURL = "__INGEST_URL__"
@progressFile = "xiaoju-sync.json"

// 读进度。since 是给“查找照片”用的日期文字（精确到秒）；key 是精确到毫秒的数字（yyyyMMddHHmmssSSS），
// 用来判断一张照片是不是已经处理过：拍摄时间不晚于 key 的都处理过了
@saved = getFile(progressFile, false)
@progress = getDictionary(saved)
@sinceValue = getValue(progress, "since")
@keyValue = getValue(progress, "key")
@sinceText = "{sinceValue}"
@sinceKey = "{keyValue}"
@fresh = 0
if !keyValue {
    @fresh = 1
    @sinceText = "1971-01-01 00:00:00"
    @sinceKey = "19710101000000000"
}

@uploaded = 0
@skipped = 0
@done = 0
@stalled = 0
@progressed = 0
repeat batch for 10 {
    if done == 0 {
        // build.py 把这一步换成「查找照片」：创建日期晚于 sinceText，按创建日期最旧的排最前，限制 50 张
        @photos = getLatestPhotos(50)
        @found = count(photos)
        @advanced = 0
        for photo in photos {
            @created = getImageDetail(photo, "Creation Date")
            @createdKey = formatDate(created, "Custom", "yyyyMMddHHmmssSSS")
            @delta = createdKey - sinceKey
            if delta.number > 0 {
                @name = getImageDetail(photo, "Name")
                // 视频先用「编码视频」（Passthrough：原尺寸、不重新压缩）导出成文件再传，见 backup.cherri
                @mediaType = getImageDetail(photo, "Media Type")
                @kind = "{mediaType}"
                // 不用 else if：Cherri 1.3.2 编译 else if 时“结束”放错位置，后面的操作会被关进别的分支里
                @isVideo = 0
                if kind == "Video" {
                    @isVideo = 1
                }
                if kind == "视频" {
                    @isVideo = 1
                }
                if kind == "影片" {
                    @isVideo = 1
                }
                @file = photo
                if isVideo == 1 {
                    @file = encodeVideo(photo)
                }
                @resp = uploadFile(uploadURL, file, {"X-File-Name": "{name}"})
                // 返回 JSON（大文件前面会有保持连接用的空格）：先转成词典再取 result（uploaded / skipped）
                @respDict = getDictionary(resp)
                @resultValue = getValue(respDict, "result")
                @result = "{resultValue}"
                if result == "uploaded" {
                    @uploaded += 1
                } else {
                    if result == "skipped" {
                        @skipped += 1
                    } else {
                        alert("{name} 没传上去：{resp}\n\n这次新上传 {uploaded} 张，进度已保存。检查网络后再运行一次，会从这张接着传。", "上传失败")
                        stop()
                    }
                }
                @sinceText = formatDate(created, "Custom", "yyyy-MM-dd HH:mm:ss")
                @sinceKey = createdKey
                @advanced = 1
                @progressed = 1
                @state = {"since": "{sinceText}", "key": "{sinceKey}"}
                saveFile(progressFile, state, true)
            }
        }
        // 不满一批：后面没有照片了。满一批却一张都没处理：日期条件没生效（或 50 张拍摄时间完全相同），不能当成传完了
        if found.number < 50 {
            @done = 1
        }
        if advanced == 0 {
            @done = 1
            if found.number == 50 {
                @stalled = 1
            }
        }
    }
}

// 第一次运行一张都没找到：多半是没给“完全访问”照片的权限，或者日期条件没生效，不能报“都备份好了”
if fresh == 1 {
    if progressed == 0 {
        alert("相册里一张照片也没找到。\n\n请到 设置 → 隐私与安全性 → 照片 → 快捷指令，选「完全访问」，再运行一次。", "没找到照片")
        stop()
    }
}
if stalled == 1 {
    alert("这次新上传 {uploaded} 张，进度停在 {sinceText}。\n\n后面的照片查不出来（“查找照片”的日期条件可能没生效）。请把这个提示截图发给维护网盘的人。", "同步卡住了")
    stop()
}
if done == 1 {
    @tail = "🎉 相册里的照片都备份好了"
} else {
    @tail = "⏩ 后面还有照片，再运行一次接着传"
}
alert("✅ 新上传 {uploaded} 张\n☑️ 以前传过 {skipped} 张\n📍 已备份到 {sinceText} 拍的照片\n\n{tail}", "相册同步")

// “备份照片到小桔云盘”快捷指令（Cherri 语言，https://github.com/electrikmilk/cherri）。
// 由 shortcuts/build.py 编译、签名，发布网页时一起放到 GitHub Pages（xiaoju-backup.shortcut）。
// 从相册多选照片 / 视频，一张张用“只能上传”的密钥传进网盘根目录的“相册”文件夹，传过的自动跳过。
#include 'actions/photos'
#include 'actions/images'
#include 'actions/scripting'
#define name 备份照片到小桔云盘
#define color orange
#define glyph cloud
#question url "网盘上传地址（一般不用改）" "__INGEST_URL__"
#question key "上传密钥：网盘「🔐 安全」→「新建上传密钥」生成的那串 xju_…" ""

// 「获取 URL 的内容」：POST，请求体是文件本身
action 'downloadurl' uploadFile(
    text url: 'WFURL',
    variable file: 'WFRequestVariable',
    dictionary! headers: 'WFHTTPHeaders'
) {
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File",
    "ShowHeaders": true
}

// 安装时填的地址和密钥（导入问题绑定在这两个“文本”操作上）
@uploadURL = text(url )  // Cherri 1.3.2：问题引用后面要留个空格
@uploadKey = text(key )

@photos = selectPhotos(true)
@uploaded = 0
@skipped = 0
for photo in photos {
    @name = getImageDetail(photo, "Name")
    @resp = uploadFile(uploadURL, photo, {"X-Xiaoju-Upload-Key": "{uploadKey}", "X-File-Name": "{name}"})
    @result = "{resp['result']}"
    if result == "uploaded" {
        @uploaded += 1
    } else if result == "skipped" {
        @skipped += 1
    } else {
        alert("{name} 没传上去：{resp}\n\n已上传 {uploaded} 张。检查密钥和网络后再运行一次，传过的会自动跳过。", "上传失败")
        stop()
    }
}
showNotification("上传 {uploaded} 张，跳过 {skipped} 张（以前传过）", "照片备份完成")

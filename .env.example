# ---- 基础 ----
XIAOJU_HTTP_ADDR=:8080
XIAOJU_DATABASE_URL=postgres://xiaoju:xiaoju@localhost:5432/xiaoju?sslmode=disable
# API 访问令牌（Authorization: Bearer <token>）
XIAOJU_ADMIN_TOKEN=change-me
# 主密钥，用于加密每个文件的密钥：openssl rand -hex 32
# 丢失后所有文件都无法解密，务必单独备份！
XIAOJU_MASTER_KEY=
# 存储驱动：telegram | local（local 用于本地开发，不需要 Telegram）
XIAOJU_STORAGE=telegram
# 分块大小（字节），telegram 最大 2000MiB，默认 256MiB
XIAOJU_PART_SIZE=268435456
# 允许跨域调用 API 的网页地址（逗号分隔），如 GitHub Pages 前端 https://<用户名>.github.io；* 表示任意来源
# XIAOJU_CORS_ORIGINS=https://<用户名>.github.io
# 上传时加密分块的临时目录，需要至少 1 个分块大小的空间
# XIAOJU_TMP_DIR=/tmp
# local 驱动的数据目录
XIAOJU_LOCAL_DIR=./data/blobs

# ---- Telegram ----
# 在 https://my.telegram.org 申请 api_id / api_hash
TG_APP_ID=
TG_APP_HASH=
# 通过 @BotFather 创建 Bot 获取
TG_BOT_TOKEN=
# 私有频道 ID（-100 开头的形式或裸 ID 都可以），Bot 必须是该频道管理员
TG_CHANNEL_ID=
TG_SESSION_FILE=./data/tg-session.json
# 连接方式：tcp（默认，直连）| websocket（经 *.web.telegram.org:443，适合限制直连的平台）
TG_TRANSPORT=tcp

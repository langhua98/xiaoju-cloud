// “备份照片到小桔云盘”快捷指令（Cherri 语言，https://github.com/electrikmilk/cherri）。
// 由 shortcuts/build.py 编译、签名，发布网页时一起放到 GitHub Pages（xiaoju-backup.shortcut）。
//
// 不用相册的选择器：一次选几百张时，iOS 要先把每张照片都准备好放进内存才交给快捷指令，点完「添加」就卡住或闪退。
// 改成先选传什么（隐藏相册 / 整个相册 / 接着上次 / 最近 7 天 / 最近 30 天 / 某一天起），再按拍摄时间从旧到新、
// 一批 30 张地用「查找照片」查出来，一张张传进网盘（只进不出，不需要密钥），传过的服务端会跳过：
//   - 隐藏相册：只传“已隐藏”相簿里的，放进网盘根目录的“隐藏相册”文件夹；进度单独存在 xiaoju-hidden.json，
//     每次运行都从上次传到的地方接着传；
//   - 其他：只传没隐藏的，放进“相册”文件夹；进度存在 xiaoju-backup.json，「接着上次」从那里接着传，以后用它只传新拍的。
// 进度（传到哪张照片的拍摄时间）存在 iCloud 云盘「快捷指令」文件夹里，每传好一张存一次：中途停了（锁屏、断网、出错）
// 再运行一次就从那张接着传。
// 快捷指令运行时看不到进度，所以用不响铃的通知报进度：开始一条、每个视频一条（大视频慢）、每 10 个一条。
#include 'actions/photos'
#include 'actions/images'
#include 'actions/scripting'
#include 'actions/media'
#include 'actions/documents'
#include 'actions/calendar'
#define name 备份照片到小桔云盘
#define color orange
#define glyph cloud

// 「获取 URL 的内容」：POST，请求体是文件本身
action 'downloadurl' uploadFile(
    text url: 'WFURL',
    variable file: 'WFRequestVariable',
    dictionary! headers: 'WFHTTPHeaders'
) {
    "WFHTTPMethod": "POST",
    "WFHTTPBodyType": "File",
    "ShowHeaders": true
}

// 上传地址：构建时由 build.py 换成网盘地址
@uploadURL = "__INGEST_URL__"
@progressFile = "xiaoju-backup.json"

// 上次的进度。since 是给“查找照片”用的日期文字（精确到秒）；key 是精确到毫秒的数字（yyyyMMddHHmmssSSS），
// 用来判断一张照片是不是已经处理过：拍摄时间不晚于 key 的都处理过了
@saved = getFile(progressFile, false)
@progress = getDictionary(saved)
@savedSince = getValue(progress, "since")
@savedKey = getValue(progress, "key")

// 选传什么（不用 else if：Cherri 1.3.2 编译 else if 时“结束”放错位置）
if savedKey {
    @options = list("▶️ 接着上次（只传之后拍的）", "🙈 隐藏相册", "🗂 整个相册（从最早的开始）", "📅 最近 7 天", "📅 最近 30 天", "📅 从某一天开始")
    @chosen = chooseFromList(options, "要传哪些照片？上次已经传到 {savedSince} 拍的")
} else {
    @options = list("🙈 隐藏相册", "🗂 整个相册（从最早的开始）", "📅 最近 7 天", "📅 最近 30 天", "📅 从某一天开始")
    @chosen = chooseFromList(options, "要传哪些照片？")
}
@choice = "{chosen}"
@sinceText = ""
@sinceKey = ""
@now = currentDate()
@start = now
@fromDate = 0
@hiddenOnly = 0
@albumKey = ""
@scope = "照片"
@folderName = "相册"
if choice == "🙈 隐藏相册" {
    @hiddenOnly = 1
    @albumKey = "hidden"
    @scope = "隐藏相册里的照片"
    @folderName = "隐藏相册"
    @progressFile = "xiaoju-hidden.json"
    @hiddenSaved = getFile(progressFile, false)
    @hiddenProgress = getDictionary(hiddenSaved)
    @hiddenSince = getValue(hiddenProgress, "since")
    @hiddenKey = getValue(hiddenProgress, "key")
    if hiddenKey {
        @sinceText = "{hiddenSince}"
        @sinceKey = "{hiddenKey}"
    } else {
        @sinceText = "1971-01-01 00:00:00"
        @sinceKey = "19710101000000000"
    }
}
if choice == "▶️ 接着上次（只传之后拍的）" {
    @sinceText = "{savedSince}"
    @sinceKey = "{savedKey}"
}
if choice == "📅 最近 7 天" {
    @start = adjustDate(now, "Subtract", 7, "days")
    @fromDate = 1
}
if choice == "📅 最近 30 天" {
    @start = adjustDate(now, "Subtract", 30, "days")
    @fromDate = 1
}
if choice == "📅 从某一天开始" {
    @start = prompt("从哪天拍的照片开始传？", "Date")
    @fromDate = 1
}
if choice == "🗂 整个相册（从最早的开始）" {
    @sinceText = "1971-01-01 00:00:00"
    @sinceKey = "19710101000000000"
}
if fromDate == 1 {
    // 从那天 0 点开始（往前多算 1 秒，0 点整拍的那张也算在内）
    @day = adjustDate(start, "Get Start of Day")
    @edge = adjustDate(day, "Subtract", 1, "sec")
    @sinceText = formatDate(edge, "Custom", "yyyy-MM-dd HH:mm:ss")
    @sinceKey = formatDate(edge, "Custom", "yyyyMMddHHmmssSSS")
}
@startText = sinceText
showNotification("{scope}：从 {sinceText} 之后拍的开始，一批 30 张往后传，放进网盘的“{folderName}”。传完前别锁屏、别切走", "小桔云盘 · 开始备份", false)

@uploaded = 0
@skipped = 0
@processed = 0
@sinceNote = 0
@done = 0
@stalled = 0
repeat batch for 200 {
    if done == 0 {
        // build.py 把这两步依次换成「查找照片」：创建日期晚于 sinceText，“已隐藏”分别是 假 / 真，
        // 按创建日期最旧的排最前，限制 30 张（顺序要和 build.py 的 PLACEHOLDERS["backup"] 对应）
        if hiddenOnly == 0 {
            @photos = getLatestPhotos(30)
        } else {
            @photos = getLatestPhotos(30)
        }
        @found = count(photos)
        @advanced = 0
        for photo in photos {
            @created = getImageDetail(photo, "Creation Date")
            @createdKey = formatDate(created, "Custom", "yyyyMMddHHmmssSSS")
            @delta = createdKey - sinceKey
            if delta.number > 0 {
                @processed += 1
                @name = getImageDetail(photo, "Name")
                // 视频先用「编码视频」（Passthrough：原尺寸、不重新压缩）导出成文件再传。直接拿相册里的视频项上传，
                // 某些视频（录屏、慢动作、原片在 iCloud）会报“produced no file representation for type public.mpeg-4”并停下。
                // “媒体类型”只读照片库记录，不需要导出文件；中文系统里可能显示成“视频”或“影片”。
                @mediaType = getImageDetail(photo, "Media Type")
                @kind = "{mediaType}"
                @isVideo = 0
                if kind == "Video" {
                    @isVideo = 1
                }
                if kind == "视频" {
                    @isVideo = 1
                }
                if kind == "影片" {
                    @isVideo = 1
                }
                @file = photo
                if isVideo == 1 {
                    @file = encodeVideo(photo)
                    @size = getFileDetail(file, "File Size")
                    showNotification("第 {processed} 个 · {name}（{size}）上传中，视频大要等一会儿", "小桔云盘 · 上传视频", false)
                    @sinceNote = 0
                }
                @resp = uploadFile(uploadURL, file, {"X-File-Name": "{name}", "X-Xiaoju-Album": "{albumKey}"})
                // 返回 JSON（大文件前面会有保持连接用的空格）：先转成词典再取 result（uploaded / skipped），
                // 不能直接 resp['result']——那会编译成读取文件属性
                @respDict = getDictionary(resp)
                @resultValue = getValue(respDict, "result")
                @result = "{resultValue}"
                if result == "uploaded" {
                    @uploaded += 1
                } else {
                    if result == "skipped" {
                        @skipped += 1
                    } else {
                        alert("{name} 没传上去：{resp}\n\n这次新上传 {uploaded} 个，进度已保存。检查网络后再运行一次，还选这一项就从这张接着传。", "上传失败")
                        stop()
                    }
                }
                @sinceText = formatDate(created, "Custom", "yyyy-MM-dd HH:mm:ss")
                @sinceKey = createdKey
                @advanced = 1
                @state = {"since": "{sinceText}", "key": "{sinceKey}"}
                saveFile(progressFile, state, true)
                @sinceNote += 1
                if sinceNote == 10 {
                    showNotification("已处理 {processed} 个 · 新传 {uploaded} · 跳过 {skipped}\n已传到 {sinceText} 拍的", "小桔云盘 · 备份中", false)
                    @sinceNote = 0
                }
            }
        }
        // 不满一批：后面没有照片了。满一批却一张都没处理：日期条件没生效（或 30 张拍摄时间完全相同），不能当成传完了
        if found.number < 30 {
            @done = 1
        }
        if advanced == 0 {
            @done = 1
            if found.number == 30 {
                @stalled = 1
            }
        }
    }
}

if processed == 0 {
    if stalled == 0 {
        // 一张也没找到：顺便查一下是哪一步查不到（截图发给维护的人就知道原因）。build.py 把下面三步依次换成
        // 「查找照片：创建日期晚于 1971 年」「查找照片：已隐藏 是 真」，第三步保留「获取最新的照片」（没有任何条件）
        @sinceText = "1971-01-01 00:00:00"
        @diagDate = getLatestPhotos(5)
        @diagHidden = getLatestPhotos(5)
        @diagLatest = getLatestPhotos(5)
        @nDate = count(diagDate)
        @nHidden = count(diagHidden)
        @nLatest = count(diagLatest)
        alert("{scope}：{startText} 之后拍的都传过了，或者一张也没找到。\n\n如果明明有：到 设置 → 隐私与安全性 → 照片 → 快捷指令，选「完全访问」；传隐藏相册时可以先到 设置 → App → 照片，关掉「使用面容 ID」，传完再打开。\n\n诊断（各最多 5）：最新 {nLatest} · 按日期 {nDate} · 已隐藏 {nHidden}", "没有新照片")
        stop()
    }
}
if stalled == 1 {
    alert("这次新上传 {uploaded} 个，进度停在 {sinceText}。\n\n后面的照片查不出来（“查找照片”的日期条件可能没生效）。请把这个提示截图发给维护网盘的人。", "备份卡住了")
    stop()
}
if done == 1 {
    if hiddenOnly == 1 {
        @tail = "🎉 隐藏相册都传完了，在网盘的“隐藏相册”文件夹"
    } else {
        @tail = "🎉 到现在为止拍的都传完了。以后选「接着上次」只传新拍的"
    }
} else {
    @tail = "⏩ 后面还有，再运行一次、还选这一项接着传"
}
alert("{scope}\n✅ 新上传 {uploaded} 个\n☑️ 以前传过 {skipped} 个\n📍 已传到 {sinceText} 拍的\n\n{tail}", "照片备份")

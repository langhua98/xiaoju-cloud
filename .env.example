# ---- 基础 ----
XIAOJU_HTTP_ADDR=:8080
XIAOJU_DATABASE_URL=postgres://xiaoju:xiaoju@localhost:5432/xiaoju?sslmode=disable
# API 访问令牌（Authorization: Bearer <token>）
XIAOJU_ADMIN_TOKEN=change-me
# 主密钥，用于加密每个文件的密钥：openssl rand -hex 32
# 丢失后所有文件都无法解密，务必单独备份！
XIAOJU_MASTER_KEY=
# 存储驱动：telegram | local（local 用于本地开发，不需要 Telegram）
XIAOJU_STORAGE=telegram
# 分块大小（字节），telegram 最大 2000MiB，默认 256MiB
XIAOJU_PART_SIZE=268435456
# 允许跨域调用 API 的网页地址（逗号分隔），如 GitHub Pages 前端 https://<用户名>.github.io；* 表示任意来源
# XIAOJU_CORS_ORIGINS=https://<用户名>.github.io
# 刷脸登录（Face ID / 指纹，通行密钥）绑定的网页域名和来源。默认取 XIAOJU_CORS_ORIGINS 里第一个具体来源，一般不用设置
# XIAOJU_WEBAUTHN_RP_ID=<用户名>.github.io
# XIAOJU_WEBAUTHN_ORIGINS=https://<用户名>.github.io
# 刷脸设备和格子口令都用不了时设为 1：启动时清空已注册设备和格子口令（之后仅凭令牌登录，重新设置后务必删掉这个设置）
# XIAOJU_PASSKEY_RESET=1
# 格子口令按出题时的星期计算，这里是判断星期用的时区，默认 Asia/Shanghai
# XIAOJU_TIMEZONE=Asia/Shanghai
# 设了就在 /dav 开 WebDAV，给相册备份 App、电脑挂载用：用户名随意，密码是这个（至少 12 位：openssl rand -hex 16）。
# 私密文件夹在 WebDAV 里看不到；删除都是移进回收站
# XIAOJU_WEBDAV_PASSWORD=
# 上传时加密分块的临时目录，需要至少 1 个分块大小的空间
# XIAOJU_TMP_DIR=/tmp
# local 驱动的数据目录
XIAOJU_LOCAL_DIR=./data/blobs

# ---- Telegram ----
# 在 https://my.telegram.org 申请 api_id / api_hash
TG_APP_ID=
TG_APP_HASH=
# 通过 @BotFather 创建 Bot 获取
TG_BOT_TOKEN=
# 私有频道 ID（-100 开头的形式或裸 ID 都可以），Bot 必须是该频道管理员
TG_CHANNEL_ID=

# ---- 双备份（可选）----
# 用另一个 Telegram 账号创建的 Bot 和私有频道，每个分块会同时写一份；
# 主频道读取失败时自动改读备份，后台任务会把启用前上传的旧文件补齐。
# TG_BACKUP_BOT_TOKEN=
# TG_BACKUP_CHANNEL_ID=
# TG_BACKUP_SESSION_FILE=./data/tg-backup-session.json

# ---- 多个 Bot 轮流用（可选）----
# 同一个频道的其他管理员 Bot，和主 Bot 轮流上传、下载（逗号、空格或换行分隔）；备份频道的用第二个账号创建
# TG_EXTRA_BOT_TOKENS=
# TG_BACKUP_EXTRA_BOT_TOKENS=
TG_SESSION_FILE=./data/tg-session.json
# 连接方式：tcp（默认，直连）| websocket（经 *.web.telegram.org:443，适合限制直连的平台）
TG_TRANSPORT=tcp
